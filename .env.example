# Copy to `.env` and fill in. `.env` is ignored; this file is not.
#
# The names are committed so a newcomer can find out what the hub needs without
# anyone having to leak a value to tell them. Only names appear here, and only
# names the code actually reads — a variable documented before it is wired up
# reads as a control that exists, which is worse than no documentation at all.

# ---- required --------------------------------------------------------------

# Signs the principal the hub presents to each satellite. Satellites verify the
# signature themselves rather than trusting the hub, which is what keeps a hub
# bug an availability incident rather than a cross-tenant disclosure.
#
# The first of three mandatory settings, and the only one every process needs:
# the hub and both satellites refuse to start without it, rather than defaulting
# to a well-known secret. The two below are the hub's alone — no satellite reads
# them, so do not go looking for them in a satellite's environment.
PORTAL_PRINCIPAL_SECRET=

# The root secret every tenant's audit digest key is derived from. Mandatory:
# there is no unkeyed mode, because an unkeyed digest over a low-entropy
# parameter — an order id, a national insurance number — is recoverable by
# anyone holding the log and a candidate list.
PORTAL_AUDIT_KEY=

# Where audit records are appended, one JSON object per line. Mandatory, and on
# the critical path: writes fail closed, so a request that cannot be recorded
# does not proceed. Give it its own volume, monitor it, rotate it.
#
# Set an absolute path. A relative one resolves from the hub's own working
# directory (`apps/hub`), not from wherever this file was copied — the same trap
# `PORTAL_REGISTRY_PATH` documents below, and the reason the value here is a
# placeholder to replace rather than a default to keep.
PORTAL_AUDIT_LOG=/absolute/path/to/portal.audit.jsonl

# ---- the assistant ---------------------------------------------------------

# Absent means no assistant, which is a supported way to run this portal — the
# deterministic screens are unaffected. Present means the in-hub agent is
# available to tenants who have not opted out.
ANTHROPIC_API_KEY=

# Set to `off` to disable the assistant everywhere, whatever else is configured.
# PORTAL_AGENT=off

# Tenants that have not agreed to AI processing, or have withdrawn it. Comma
# separated. Governs the surface rather than whose model reaches it, so it
# closes the outward MCP endpoint too.
# PORTAL_AGENT_DISABLED_TENANTS=

# ---- development -----------------------------------------------------------

# The session stub is an allow-list, not a deny-list: it runs under
# `NODE_ENV=development`, or where this is set to exactly `1` — any other value
# leaves the stub off. Never set it in production: it authenticates every
# visitor as one fixed tenant.
# PORTAL_ALLOW_DEV_SESSION=1
# PORTAL_DEV_TENANT=acme
# `external` is the only value that changes anything; anything else stays
# internal, which is the default.
# PORTAL_DEV_AUDIENCE=external

# Where the satellite registry is read from, and where the satellites are.
# Defaults suit a laptop; compose overrides the URLs with service names.
#
# The registry path is resolved from the hub's own working directory
# (`apps/hub`), so the default is `../../config/satellites.yaml`. Setting it to
# `./config/satellites.yaml` points at `apps/hub/config/` and the hub fails to
# start; use an absolute path if you move it.
# PORTAL_REGISTRY_PATH=../../config/satellites.yaml
# PORTAL_ORDERS_URL=http://localhost:4001
# PORTAL_FLEET_URL=http://localhost:4002

# `PORT` is read per service — orders defaults to 4001, fleet to 4002, and
# compose sets 3000 for the hub. Listed for discoverability, and left commented
# because one shared file cannot hold three different values: set it per
# process, not here, or all three try to bind the same port.
# PORT=

# ---- test tooling ----------------------------------------------------------

# Playwright's base url, and the scopes the conformance probe should present.
# Required scopes live in the registry rather than a manifest, so the kit cannot
# discover them — a screen refused without them is reported as unchecked.
# PORTAL_HUB_URL=http://127.0.0.1:3000
# PORTAL_CONFORMANCE_SCOPES=orders.read
